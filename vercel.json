{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://open.er-api.com; manifest-src 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/recorrido-gastronomico",
      "destination": "/en/experiences",
      "permanent": true
    },
    {
      "source": "/recorrido-gastronomico",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/sabores-locales",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/sabores-locales.html",
      "destination": "/experiences",
      "permanent": true
    },
    {
      "source": "/en/sabores-locales",
      "destination": "/en/experiences",
      "permanent": true
    },
    {
      "source": "/en/sabores-locales.html",
      "destination": "/en/experiences",
      "permanent": true
    },
    {
      "source": "/pasadia-islas-rosario",
      "destination": "/islas-del-rosario",
      "permanent": true
    },
    {
      "source": "/en/pasadia-islas-rosario",
      "destination": "/en/islas-del-rosario",
      "permanent": true
    },
    {
